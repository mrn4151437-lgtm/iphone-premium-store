            font-weight: 700;
            letter-spacing: -0.5px;
            margin-bottom: 10px;
        }

        .section-header p {
            color: var(--text-muted);
            font-size: 1rem;
        }

        /* ----- CATALOGO / Destaques ----- */
        .grid-products {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 24px;
        }

        .product-card {
            background: var(--bg-card);
            border: 1px solid var(--border-card);
            border-radius: 20px;
            padding: 28px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: all 0.3s ease;
        }

        .product-card:hover {
            transform: translateY(-5px);
            background: var(--bg-card-hover);
            border-color: rgba(255,255,255,0.2);
        }

        .product-icon {
            font-size: 3rem;
            margin: 20px 0;
            text-align: center;
            color: var(--accent-blue);
        }

        .product-card h3 {
            font-size: 1.25rem;
            margin-bottom: 8px;
        }

        .product-card p {
            color: var(--text-muted);
            font-size: 0.85rem;
            margin-bottom: 20px;
        }

        .btn-sm {
