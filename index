            justify-content: space-between;
            padding: 10px 0;
            border-bottom: 1px solid var(--border-card);
            font-size: 0.88rem;
        }

        .row-info:last-child {
            border-bottom: none;
        }

        .row-info span {
            color: var(--text-muted);
        }

        .row-info strong {
            color: var(--text-main);
            text-align: right;
